  Dgen = NULL,
  Dgeo = NULL,
  Dgeo_trans = "Dgeo",
  Dgen_trans = "Dgen",
  permutations = 999,
  plot.out = TRUE,
  paircols = "pop",
  save2tmp = FALSE,
  verbose = NULL,
  plot_theme = theme_minimal())
  
