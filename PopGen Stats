# Isolation By Distance {R}

library(adegenet)
library(dartR)
library(ggplot2)
library(RColorBrewer)

x <- read.genepop("~/Desktop/populations.snps.gen")
x

biden_coordinates <- biden_lat_lon_pacific

gen2 <- gi2gl(x)
gen2@other$latlon <- biden_coordinates[,3:4]

gen2$pop <- factor(
  gen2$pop,
  levels = c("WP.FPMo9", "WP.FPTuMA2","WP.KirLMi2","WP.AS2", "WP.CNMI1", "WP.GuamU8", "WP.KirPK1", "WP.LineP2", "WP.Marsh1", "WP.PNG1"),
