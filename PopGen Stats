# Reynold's and Nei's Numbers {R}

library("poppr")
library(adegenet)
library(ape)
library(hierfstat)

x <- read.genepop("~/Desktop/populations.snps.gen")
x

x$pop <- factor(
  x$pop,
  levels = c("WP.GuamP27_Be", "WP.KirPN1", "WP.PNG2_C", "WP.FPMo22", "WP.GuamW1_G", "WP.KirLM3", "WP.GuamU1_Sp", "WP.GuamU4", "WP.GuamL24_D", "WP.Tai1_R", "WP.GuamP3_F", "WP.MasR2", "WP.PNG1", "WP.FPMarUH1", "WP.KirLMi2"),
  labels = c("T. serenei", "T. lutea", "T. cymodoce", "T. punctimanus","T. guttata", "T. tigrina", "T. speciosa", "T. formosa", "T. digitalis","T. rufopunctata","T. flavopunctata","T. bidentata - Indian Ocean","T. bidentata - West Pacific","T. bidentata - Marquesas Is.","T. bidentata - Central Pacific")
  )

x2 <- genind2genpop(
  x,
  pop = NULL,
  quiet = FALSE,
  process.other = FALSE,
  other.action = mean
)
rey <- dist.genpop(x2, method = 3, diag = FALSE, upper = FALSE)
nei <- dist.genpop(x2, method = 1, diag = FALSE, upper = FALSE)

write.csv(as.matrix(rey), "~/Desktop/reynoldsD.csv")
write.csv(as.matrix(nei), "~/Desktop/neisD.csv")


# Pairwise Fst {R}

library(StAMPP)
library(dartR)
library(ade4)

x <- read.genepop("~/Desktop/populations.snps.gen")
x

xgl<-gi2gl(x, verbose=2)#stamppFst needs a genlight object
fsttable_pval<-stamppFst(xgl, nboots = 1000, percent = 95, nclusters = 4)#This is with pvalues and bootstraps.
fsttable_pval

n <- as.numeric(unlist(fsttable_pval))

p.adjust(n, method = "bonferroni", n = length(n))

write.csv(fsttable_pval$Fsts, "~/Desktop/pairwise_FST_table_biden_clades_nowake.csv")
write.csv(fsttable_pval$Pvalues, "~/Desktop/pairwise_FST_pval_biden_clades_nowake.csv")


